  "dependencies": {
    "@types/chart.js": "^4.0.0",
    "autoprefixer": "^10.7.0",
    "axios": "1.20.0",
    "chart.js": "^4.6.1",
    "pinia": "^4.1.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "vue": "^3.5.46",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.16.1",
    "@tsconfig/node26": "^26.0.2",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.6.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "jsdom": "^30.1.3",
    "prettier": "^3.10.1",
    "typescript": "~5.9.3",
